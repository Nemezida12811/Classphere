+                gas=t["gas"], light=t["light"], sound=t["sound"],
+                units=t.get("units"),
+            ))
+            session.commit()
+
+    @staticmethod
+    def _find_latest(device_id: str) -> Optional[dict]:
+        with _db.SessionLocal() as session:
+            r = (session.query(SensorReading)
+                 .filter(SensorReading.device_id == device_id)
