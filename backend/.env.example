# App settings
PROJECT_NAME="Smart School Environment API"
DEBUG=True
API_V1_PREFIX=/api/v1

# Security & JWT
SECRET_KEY=supersecretkey_change_me_in_production_1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For SQLite (default development):
DATABASE_URL=sqlite:///./school_env.db

# For PostgreSQL (Docker):
# DATABASE_URL=postgresql://school_user:school_pass@db:5432/school_db

# MQTT (leave empty to disable; the backend still works via REST and the simulator)
MQTT_URL=
# MQTT_URL=mqtt://localhost:1883

# Run WITHOUT a physical device: built-in simulator writes fake telemetry
SIMULATE_DEVICES=true
SIMULATE_DEVICE_IDS=sim-room-1,sim-room-2,sim-room-3
SIMULATE_INTERVAL_SEC=5

# Optional AI recommendations (without a key a rule-based fallback is used)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
