# App settings
PROJECT_NAME="Smart School Environment API"
DEBUG=True
API_V1_PREFIX=/api/v1

# Security & JWT
SECRET_KEY=supersecretkey_change_me_in_production_1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For SQLite (default development):
DATABASE_URL=sqlite:///./school_env.db

# For PostgreSQL (Docker):
# DATABASE_URL=postgresql://school_user:school_pass@db:5432/school_db

# Server for `python -m app` (the frontend expects port 3001)
HOST=127.0.0.1
PORT=3001

# Built-in device simulator: fake telemetry, no MQTT broker / hardware needed
SIMULATE_DEVICE=true
SIM_DEVICES=3
SIM_INTERVAL_SECONDS=3
SIM_SPEED=30

# Real devices via MQTT (leave empty to disable)
MQTT_URL=
